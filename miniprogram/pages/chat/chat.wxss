page { height: 100%; background: #C9B29A; }

.root {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

/* —— 身后天气世界 —— */
.world, .plate, .shade, .glow, .haze, .fx {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.world { z-index: 0; background: #C9B29A; }
.plate {
  background-size: cover;
  background-position: 50% 42%;
  background-repeat: no-repeat;
  opacity: 0;
  transition: opacity 1.6s ease;
}
.plate.on { opacity: 1; }
.shade { z-index: 1; mix-blend-mode: multiply; transition: background-color 1.6s linear; }
.glow { z-index: 1; mix-blend-mode: screen; transition: background-color 1.6s linear; }
.haze {
  z-index: 1;
  background: linear-gradient(180deg, rgba(236,238,240,.34), rgba(236,238,240,.12) 70%);
  transition: opacity 1.6s ease;
}
.fx { z-index: 1; width: 100%; height: 100%; }

/* —— 画布形态：圆角手机框浮在天气上 —— */
.stage {
  position: relative;
  z-index: 2;
  height: 100%;
  box-sizing: border-box;
  padding: 12px 14px 10px;
  display: flex;
  align-items: stretch;
  justify-content: center;
}

/* 与网页 valley 营地一致 */
.phone {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #243044;
  color: #5c5348;
  font-family: "Yuanti SC", "STYuanti", "PingFang SC", sans-serif;
  border-radius: 32px;
  box-shadow: 0 28px 64px rgba(92, 83, 72, 0.22);
  isolation: isolate;
}
.phone::before, .phone::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}
.phone::before { mix-blend-mode: multiply; background-color: var(--phone-shade, transparent); }
.phone::after { mix-blend-mode: screen; background-color: var(--phone-glow, transparent); }
.phone > .scene { position: absolute; inset: 0; z-index: 1; }
.phone > .chrome, .phone > .note, .phone > .motes, .phone > .composer, .phone > .settings, .phone > .splash {
  z-index: 1;
}

.scene { position: absolute; inset: 0; z-index: 1; overflow: hidden; }

.skyband { position: absolute; left: 0; right: 0; top: 0; height: 46%; overflow: hidden; z-index: 1; }
.sky-dawn .skyband { background: linear-gradient(#c5d5df 0%, #f3d7c4 46%, #e7c4a4 100%); }
.sky-morning .skyband { background: linear-gradient(#b9daf0 0%, #f4ecd0 48%, #d5e2b8 100%); }
.sky-noon .skyband { background: linear-gradient(#8ec8ee 0%, #f6e7b0 42%, #c9d98a 100%); }
.sky-afternoon .skyband { background: linear-gradient(#f0b56a 0%, #f6d7a4 40%, #e2c07a 100%); }
.sky-dusk .skyband { background: linear-gradient(#f0b09a 0%, #e36a42 40%, #f2b56a 78%, #e8c48a 100%); }
.sky-night .skyband { background: linear-gradient(#0c1424 0%, #1c2c44 55%, #243044 100%); }
.sky-late .skyband { background: linear-gradient(#05080f 0%, #121a28 70%, #1a2434 100%); }

.ridge { position: absolute; left: -4%; right: -4%; }
.ridge.far {
  bottom: 34%; height: 38%; background: #a3b896;
  clip-path: polygon(0 78%, 6% 70%, 14% 82%, 22% 48%, 31% 74%, 40% 36%, 49% 68%, 58% 42%, 67% 72%, 78% 30%, 88% 64%, 100% 46%, 100% 100%, 0 100%);
}
.ridge.near {
  bottom: -2%; height: 42%; background: #5e7a52;
  clip-path: polygon(0 62%, 8% 48%, 18% 70%, 27% 34%, 38% 58%, 48% 28%, 60% 64%, 72% 40%, 84% 66%, 94% 44%, 100% 58%, 100% 100%, 0 100%);
}
.sky-dusk .ridge.far { background: #7a5a72; }
.sky-dusk .ridge.near { background: #4a342c; }
.sky-night .ridge.far, .sky-late .ridge.far { background: #3a4a62; }
.sky-night .ridge.near, .sky-late .ridge.near { background: #1c2838; }

.trees {
  position: absolute; left: 0; right: 0; bottom: 6%; height: 28%;
  background:
    radial-gradient(ellipse 10px 22px at 8% 100%, #3d5538 0 70%, transparent 72%),
    radial-gradient(ellipse 7px 16px at 14% 100%, #2f4630 0 70%, transparent 72%),
    radial-gradient(ellipse 12px 26px at 86% 100%, #3a5236 0 70%, transparent 72%),
    radial-gradient(ellipse 8px 18px at 93% 100%, #2c422c 0 70%, transparent 72%),
    radial-gradient(ellipse 6px 14px at 46% 100%, #4a6244 0 70%, transparent 72%);
}
.sky-night .trees, .sky-late .trees { opacity: .7; }

.sun, .moon { position: absolute; border-radius: 50%; }
.sun {
  top: 14%; right: 14%; width: 36px; height: 36px; background: #ffe9a6;
  box-shadow: 0 0 0 8px rgba(255,230,150,.35), 0 0 22px #ffe7a8;
}
.moon {
  top: 12%; right: 16%; width: 28px; height: 28px; background: #f4f0e4;
  box-shadow: 0 0 14px rgba(244,240,228,.85); display: none;
}
.sky-dusk .sun, .sky-night .sun, .sky-late .sun { display: none; }
.sky-night .moon, .sky-late .moon { display: block; }

.stars {
  position: absolute; inset: 0; display: none;
  background-image: radial-gradient(#fff 1.1px, transparent 1.5px), radial-gradient(#fff 0.8px, transparent 1.2px);
  background-size: 28px 22px, 40px 36px;
  background-position: 0 0, 12px 10px;
}
.sky-night .stars, .sky-late .stars { display: block; opacity: .85; }

.smoke {
  position: absolute; left: 22%; bottom: 0; width: 10px; height: 0; display: none; border-radius: 10px;
}
.fire-small .smoke, .fire-full .smoke, .fire-blaze .smoke {
  display: block; height: 48px;
  background: linear-gradient(rgba(255,255,255,.45), transparent);
  filter: blur(3px);
  animation: smoke 3s ease-in-out infinite;
}
.fire-full .smoke { height: 64px; }
.fire-blaze .smoke { height: 78px; }

.field {
  position: absolute; left: 0; right: 0; top: 40%; bottom: 0;
  background: linear-gradient(#d5e4b4, #8fb56c 48%, #6d934c);
}
.sky-afternoon .field { background: linear-gradient(#e6cb86, #c4a15c 52%, #8f9a58); }
.sky-dusk .field { background: linear-gradient(#f0b07a, #c47a48 55%, #8f5a3c); }
.sky-night .field, .sky-late .field { background: linear-gradient(#243044, #1a2434 58%, #141c28); }

.fall { position: absolute; inset: 0; pointer-events: none; z-index: 3; opacity: 0; }
.wet-rain .fall {
  opacity: .7;
  background-image: repeating-linear-gradient(104deg, transparent 0 12px, rgba(230,240,255,.45) 12px 13px);
  animation: rain-fall .7s linear infinite;
}
.wet-snow .fall {
  opacity: .85;
  background-image: radial-gradient(circle, #fff 1.1px, transparent 1.6px);
  background-size: 26px 32px;
  animation: snow-fall 7s linear infinite;
}

.stage-ground { position: absolute; left: 0; right: 0; bottom: 0; height: 42%; z-index: 2; }
.soil {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 7px 4px at 10% 58%, #f3ece2 0 32%, #a3988c 58%, #6e655c 78%, transparent 80%),
    radial-gradient(ellipse 5px 3px at 18% 74%, #efe6da 0 30%, #8d847a 60%, transparent 80%),
    radial-gradient(ellipse 6px 3.5px at 88% 52%, #f4eee6 0 30%, #9a9186 56%, #645c54 78%, transparent 80%),
    linear-gradient(180deg, #c6d9a8 0%, #8fb56c 55%, #6d934c 100%);
}
.ground-snow .soil {
  background:
    radial-gradient(ellipse 6px 3px at 14% 64%, #ffffff 0 30%, #d5dee6 70%, transparent 80%),
    linear-gradient(180deg, #f7fafc, #d5dee6);
}
.sky-dusk .soil {
  background:
    radial-gradient(ellipse 7px 4px at 12% 70%, #f6efe2 0 32%, #b08968 60%, transparent 80%),
    linear-gradient(180deg, #e7b07a, #c48458 58%, #a86b44);
}
.sky-night .soil, .sky-late .soil {
  background:
    radial-gradient(ellipse 6px 3px at 14% 68%, #8a93a0 0 30%, #3a4454 70%, transparent 80%),
    linear-gradient(180deg, #2c3a4e, #1c2836);
}
.ground-gold .soil {
  background:
    radial-gradient(ellipse 7px 4px at 12% 60%, #f6efe2 0 32%, #b7a48a 60%, transparent 80%),
    radial-gradient(ellipse 5px 3px at 86% 68%, #f3eadc 0 30%, #a89070 62%, transparent 80%),
    linear-gradient(180deg, #e6cb86, #c4a15c 50%, #8f9a58);
}

.logs {
  position: absolute; left: 5%; bottom: 28%; width: 32px; height: 8px;
  background: #6b442c; border-radius: 4px;
  box-shadow: 10px -7px 0 #8a5a38, 3px -13px 0 #5c3a24, 18px -4px 0 #7a4e32;
  transform: rotate(-8deg); z-index: 1;
}

.tent, .blaze { display: none; }
.fire-small .tent, .fire-full .tent, .fire-blaze .tent,
.fire-small .blaze, .fire-full .blaze, .fire-blaze .blaze,
.fire-brazier .blaze { display: block; }
.fire-small .blaze, .fire-brazier .blaze { transform: scale(0.55); transform-origin: left bottom; }
.fire-blaze .blaze { transform: scale(1.2); transform-origin: left bottom; }

.tent { position: absolute; right: 3%; bottom: 12%; width: 62px; height: 48px; z-index: 1; }
.tent-cone {
  position: absolute; left: 6px; bottom: 0; width: 0; height: 0;
  border-left: 25px solid transparent; border-right: 25px solid transparent; border-bottom: 46px solid #d4653c;
  filter: drop-shadow(0 2px 0 #8a3e28);
}
.tent-door {
  position: absolute; left: 23px; top: 22px; width: 0; height: 0;
  border-left: 8px solid transparent; border-right: 8px solid transparent; border-bottom: 22px solid #4a2a1c;
}
.tent-pole { position: absolute; left: 28px; bottom: 44px; width: 2px; height: 10px; background: #5c3a24; }
.tent-flag {
  position: absolute; left: 23px; bottom: 54px; width: 0; height: 0;
  border-left: 6px solid transparent; border-right: 6px solid transparent; border-bottom: 7px solid #f2d48a;
}

.blaze { position: absolute; left: 8%; bottom: 22%; width: 28px; height: 34px; z-index: 2; }
.blaze::before {
  content: ""; position: absolute; left: -4px; bottom: 0; width: 34px; height: 8px;
  border-radius: 8px; background: #5c4638; box-shadow: inset 0 2px 0 #3a2c24;
}
.flame-i {
  position: absolute; bottom: 6px; width: 12px; height: 26px;
  border-radius: 12px 12px 4px 4px;
  background: linear-gradient(#fff4c4, #f08a3c 55%, #c44820);
  animation: flicker 0.8s ease-in-out infinite;
}
.flame-i.a { left: 0; }
.flame-i.b { left: 10px; height: 18px; animation-delay: -.3s; }
.fire-small .stage-ground::after, .fire-full .stage-ground::after, .fire-blaze .stage-ground::after {
  content: ""; position: absolute; left: 0; bottom: 14%; width: 120px; height: 70px; pointer-events: none;
  background: radial-gradient(circle, rgba(255,168,64,.28), transparent 72%);
}
.fire-boost .stage-ground::after { transform: scale(1.35); opacity: 1; }

.otter {
  position: absolute; left: 50%; bottom: 78px; height: 300px;
  width: 248px; margin-left: -124px; z-index: 3;
  transition: transform .6s ease; pointer-events: auto;
}
.otter-shadow {
  position: absolute; left: 50%; bottom: 0; width: 62%; height: 16px;
  transform: translateX(-50%);
  background: radial-gradient(ellipse, rgba(40,28,16,.4), transparent 70%); z-index: 0;
}
.pose-lean { transform: rotate(-6deg) translate(7px, 2px); }
.pose-nod { animation: nod .8s ease; }
.pose-nap { animation: doze 3.2s ease-in-out infinite; }
.pose-wake { animation: wake .45s ease; }
.pose-warmth { transform: translateY(3px); }
.body {
  position: absolute; left: 50%; bottom: 0; height: 100%; width: auto;
  transform: translateX(-50%);
  display: block; background: transparent;
}
.stage-actor {
  position: absolute; left: 50%; bottom: 0; height: 100%; width: 248px;
  margin-left: -124px; z-index: 1; transform: none;
}
.still { z-index: 0; width: 248px; height: 300px; }
.still.hid, .stage-actor.hid { opacity: 0; pointer-events: none; }
.think {
  position: absolute; top: -2%; right: 6%; z-index: 5;
  padding: 4px 10px; border-radius: 14px;
  background: rgba(255,252,246,.94); color: #5c5348; font-size: 15px;
  box-shadow: 0 6px 14px rgba(60,40,20,.12);
  animation: thinkbob 1.4s ease-in-out infinite;
}

.chrome {
  position: absolute; top: 0; left: 0; right: 0; z-index: 6;
  display: flex; align-items: center; justify-content: space-between;
  padding-left: 14px; padding-right: 14px; pointer-events: none;
}
.icon-btn {
  width: 36px; height: 36px; border-radius: 50%;
  background: rgba(255,252,246,.28); color: #3d342c;
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; line-height: 1; pointer-events: auto;
}
.sky-night .icon-btn, .sky-late .icon-btn {
  color: #f7f1e6; background: rgba(255,255,255,.12);
}

/* 便签回复（对齐网页 #note） */
.note {
  position: absolute; z-index: 5; left: 28px; right: 28px; top: 68px;
  /* top 由 wxml 按 statusBar 覆盖 */
  min-height: 92px; padding: 22px 18px 36px; color: #3d342c;
  background: #f6f1e6;
  clip-path: polygon(0 10px, 8px 4px, 18px 12px, 32px 2px, 48px 10px, 64px 0, 82px 8px, 100px 2px, 120px 11px, 148px 3px, 176px 10px, 100% 6px, 100% calc(100% - 8px), calc(100% - 14px) calc(100% - 2px), calc(100% - 36px) calc(100% - 12px), calc(100% - 58px) 100%, 70% calc(100% - 6px), 48% calc(100% - 1px), 24% calc(100% - 10px), 8px calc(100% - 3px), 0 calc(100% - 12px));
  box-shadow: 0 12px 28px rgba(50,36,20,.16);
  transform: rotate(-1.2deg);
  animation: note-in .45s ease;
}
.note.away {
  transform: translateY(130%) rotate(-1.2deg);
  opacity: 0;
  pointer-events: none;
  transition: transform .4s ease, opacity .4s ease;
  animation: none;
}
.note-text {
  display: block;
  font-size: 16px;
  line-height: 1.65;
  min-height: 1.65em;
  white-space: pre-wrap;
}
.sparks { position: absolute; inset: 0; pointer-events: none; }
.spark-i {
  position: absolute; width: 8px; height: 8px; background: #f2d48a;
  clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
  animation: twinkle 1.8s ease-in-out infinite;
}
.spark-i:nth-child(1) { top: 8px; left: 10px; }
.spark-i:nth-child(2) { top: 4px; right: 36px; animation-delay: .4s; }
.spark-i:nth-child(3) { bottom: 16px; left: 18px; animation-delay: .8s; }
@keyframes note-in { from { opacity: 0; transform: translateY(-42px) rotate(-1.2deg); } to { opacity: 1; transform: rotate(-1.2deg); } }
@keyframes twinkle { 50% { opacity: .35; transform: scale(.7); } }

/* 用户 mote */
.motes { position: absolute; inset: 0; z-index: 3; pointer-events: none; overflow: hidden; }
.mote {
  position: absolute; width: 6px; height: 6px; border-radius: 50%;
  background: #f2d48a; animation: mote-up 1.5s ease forwards;
}
@keyframes mote-up { to { transform: translateY(-340px); opacity: 0; } }

/* 与网页 composer 一致：多行 + 图标发送 */
.composer {
  position: absolute; z-index: 7; left: 16px; right: 16px; bottom: 16px;
  display: flex; align-items: flex-end; gap: 8px;
  padding: 8px 8px 8px 14px; border-radius: 18px;
  background: rgba(246,241,230,.92);
}
.input {
  flex: 1; border: 0; background: transparent;
  padding: 10px 8px; font-size: 16px; font-weight: 400;
  min-height: 36px; max-height: 80px; color: #1a1612;
  line-height: 1.45; width: auto;
}
.input-ph { color: #8a7f72; }
.send {
  width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, #f2c4a0, #e8a87c);
  color: #fffdf8; display: flex; align-items: center; justify-content: center;
  margin-bottom: 2px;
}
.send-ico { width: 14px; height: 14px; }
.send.off { opacity: .45; }
.rec { flex: 1; display: flex; align-items: center; gap: 12px; color: #5c5348; }
.rec-time { font-size: 16px; }
.rec-cancel, .rec-stop {
  padding: 6px 14px; border-radius: 999px; font-size: 13px;
  background: #f2c4a0; color: #fffdf8;
}

.settings {
  position: absolute; inset: 0; z-index: 8; background: rgba(20,16,12,.35);
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: #fdf6ec; border-radius: 28rpx 28rpx 0 0; padding: 28rpx 32rpx 48rpx;
}
.sheet-title { font-size: 30rpx; margin-bottom: 16rpx; }
.row-set { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }
.mic-row { margin-top: 20rpx; }
.mic-chip {
  padding: 8rpx 20rpx; border-radius: 999rpx; background: #e8a87c; color: #fffdf8; font-size: 24rpx;
}
.sheet-note { margin-top: 12rpx; color: #b7a99a; font-size: 22rpx; }

@keyframes flicker { 50% { transform: scaleX(.86) scaleY(1.08); } }
@keyframes smoke { 50% { transform: translateY(-8px) scaleX(1.4); opacity: .7; } }
@keyframes rain-fall { to { background-position: 18px 28px; } }
@keyframes snow-fall { to { background-position: 12px 40px; } }
@keyframes thinkbob { 50% { transform: translateY(-5px); } }
@keyframes nod { 40% { transform: rotate(6deg); } 100% { transform: none; } }
@keyframes yes { 30% { transform: translateY(6rpx); } 60% { transform: translateY(0); } 80% { transform: translateY(4rpx); } }
@keyframes hug { 40% { transform: scale(1.06) translateY(-8rpx); } 100% { transform: none; } }
@keyframes doze { 50% { transform: rotate(4deg) translateY(4rpx); } }
@keyframes wake { 40% { transform: translateY(-8rpx) rotate(-3deg); } }
@keyframes type-dot { 50% { opacity: .9; } }
@keyframes wave { 50% { transform: scaleY(1.6); } }
@keyframes fadeup { to { opacity: 0; transform: translateY(-36rpx); } }
@keyframes mote { to { opacity: 0; transform: translateY(-80rpx); } }

.low .smoke, .low .fall, .low .pose-nap { animation: none; }
.low .flame-i { animation: flicker 1.1s ease-in-out infinite; }


/* —— 开屏光照系统：禁纯黑纯白，保暗部层次 + 角色本体 —— */
.splash {
  position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 20; overflow: hidden;
  background: var(--stage-bg, linear-gradient(180deg, #232048, #141430));
  --art-filter: none;
  --stage-bg: linear-gradient(180deg, #232048, #141430);
  --key-grad: none; --key-blend: soft-light; --key-opacity: 0;
  --rim-grad: none; --rim-opacity: 0;
  --shadow-grad: none; --shadow-opacity: 0;
  --fill-grad: none; --fill-blend: multiply; --fill-opacity: 0;
  --shade-grad: none; --shade-opacity: 0;
  --lift-grad: none; --lift-opacity: 0;
  --body-protect: none; --body-opacity: 0; --body-blend: soft-light;
  --hi-compress: none; --hi-opacity: 0;
  --bloom-opacity: 0; --scatter: 0;
}
.splash.leave { opacity: 0; transition: opacity .45s ease; }
.splash-art {
  width: 100%; height: 100%;
  filter: var(--art-filter);
  transition: filter 1.25s ease;
  opacity: 0; transform: translateY(30px) scale(.95);
}
.splash.on .splash-art {
  animation:
    splash-in 1.8s cubic-bezier(.22,1,.36,1) forwards,
    splash-breathe 2.4s ease-in-out 1.8s infinite;
}
@keyframes splash-breathe {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-2px) scale(1.012); }
}
.splash-fill, .splash-hi, .splash-shade, .splash-key, .splash-rim, .splash-shadow,
.splash-lift, .splash-body, .splash-veil, .splash-bloom,
.splash-period-fx, .splash-weather-fx {
  position: absolute; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none;
  transition: opacity 1.25s ease, background 1.25s ease, filter 1.25s ease;
}
.splash-fill {
  z-index: 1;
  background: var(--fill-grad);
  opacity: var(--fill-opacity);
  mix-blend-mode: var(--fill-blend);
}
.splash-hi {
  z-index: 2;
  background: var(--hi-compress);
  opacity: var(--hi-opacity);
  mix-blend-mode: multiply;
}
.splash-shade {
  z-index: 2;
  background: var(--shade-grad);
  opacity: var(--shade-opacity);
  mix-blend-mode: multiply;
}
.splash-key {
  z-index: 3;
  background: var(--key-grad);
  opacity: var(--key-opacity);
  mix-blend-mode: var(--key-blend);
}
.splash-rim {
  z-index: 4;
  background: var(--rim-grad);
  opacity: var(--rim-opacity);
  mix-blend-mode: screen;
}
.splash-shadow {
  z-index: 4;
  background: var(--shadow-grad);
  opacity: var(--shadow-opacity);
  mix-blend-mode: multiply;
}
.splash-lift {
  z-index: 5;
  background: var(--lift-grad);
  opacity: var(--lift-opacity);
  mix-blend-mode: soft-light;
}
.splash-body {
  z-index: 5;
  background: var(--body-protect);
  opacity: var(--body-opacity);
  mix-blend-mode: var(--body-blend);
}
.light-late .splash-rim,
.light-late .splash-bloom {
  opacity: 0 !important;
  background: none !important;
  filter: none !important;
}
.splash-veil { z-index: 6; opacity: 0; }
.veil-soft .splash-veil {
  opacity: 0.45;
  background: radial-gradient(ellipse 90% 70% at 50% 40%, rgba(200,205,215,0.35), rgba(160,165,180,0.2) 60%, transparent 85%);
  mix-blend-mode: soft-light;
  filter: blur(2px);
}
.veil-cold .splash-veil {
  opacity: calc(0.35 + var(--scatter) * 0.4);
  background:
    linear-gradient(180deg, rgba(140,160,180,0.35) 0%, rgba(100,120,140,0.22) 50%, rgba(80,100,120,0.3) 100%);
  mix-blend-mode: color;
}
.veil-mist .splash-veil {
  opacity: 0.55;
  background:
    radial-gradient(ellipse 100% 60% at 50% 60%, rgba(220,230,245,0.4), transparent 70%),
    linear-gradient(180deg, rgba(180,190,210,0.25), rgba(100,110,130,0.2));
  mix-blend-mode: soft-light;
  filter: blur(6px);
  animation: splash-fog-flow 6s ease-in-out infinite alternate;
}
.splash-bloom {
  z-index: 7;
  opacity: var(--bloom-opacity);
  background:
    radial-gradient(ellipse 55% 48% at 50% 58%, rgba(200,215,245,0.35) 0%, rgba(160,180,230,0.14) 40%, transparent 70%);
  mix-blend-mode: soft-light;
  filter: blur(10px);
}
.splash-period-fx { z-index: 8; opacity: 0; }
.fx-period-mist .splash-period-fx {
  opacity: 0.55;
  background:
    radial-gradient(ellipse 70% 30% at 30% 70%, rgba(255,255,255,0.28), transparent 70%),
    radial-gradient(ellipse 60% 25% at 70% 55%, rgba(255,250,240,0.2), transparent 70%);
  filter: blur(8px);
  animation: splash-fog-flow 7s ease-in-out infinite alternate;
}
.fx-period-heat .splash-period-fx {
  opacity: 0.5;
  background:
    repeating-linear-gradient(0deg, transparent 0 10px, rgba(255,200,120,0.04) 10px 12px);
  mix-blend-mode: soft-light;
  animation: splash-heatwave 2.8s ease-in-out infinite;
}
.fx-period-leaves .splash-period-fx {
  opacity: 0.7;
  background-image:
    radial-gradient(ellipse 6px 4px at 20% 10%, rgba(160,90,40,0.7), transparent 70%),
    radial-gradient(ellipse 5px 3px at 60% 0%, rgba(180,100,50,0.65), transparent 70%),
    radial-gradient(ellipse 7px 4px at 80% 20%, rgba(140,80,30,0.6), transparent 70%);
  background-size: 100% 100%;
  animation: splash-leaves 5.5s linear infinite;
}
.fx-period-fireface .splash-period-fx {
  opacity: 0.45;
  background: radial-gradient(ellipse 40% 35% at 66% 68%, rgba(255,140,60,0.28), transparent 70%);
  mix-blend-mode: soft-light;
  animation: splash-fireface 1.1s ease-in-out infinite;
}
.fx-period-embers .splash-period-fx {
  opacity: 0.75;
  background-image:
    radial-gradient(circle 2px at 55% 80%, rgba(255,160,80,0.9), transparent 70%),
    radial-gradient(circle 1.5px at 62% 85%, rgba(255,120,40,0.8), transparent 70%),
    radial-gradient(circle 1.5px at 48% 88%, rgba(255,180,100,0.75), transparent 70%);
  animation: splash-embers 4.5s linear infinite;
}
.splash-weather-fx { z-index: 9; opacity: 0; }
.fx-weather-rain .splash-weather-fx {
  opacity: 1;
  background: none;
  animation: none;
}
.splash-rain {
  position: absolute; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none;
  opacity: 0.34;
}
.splash-rain.late { opacity: 0.22; }
.splash-rain-mist {
  position: absolute; left: 0; right: 0; bottom: 0; height: 28%;
  background: linear-gradient(180deg, transparent 0%, rgba(210,215,220,0.1) 55%, rgba(190,196,205,0.14) 100%);
  filter: blur(6px);
  animation: splash-rain-mist 7s ease-in-out infinite alternate;
}
.splash-rain-ground {
  position: absolute; left: 0; right: 0; bottom: 0; height: 22%;
  background:
    linear-gradient(180deg, transparent 0%, rgba(30,36,48,0.22) 45%, rgba(24,28,38,0.32) 100%),
    linear-gradient(90deg, transparent 10%, rgba(255,255,255,0.08) 48%, transparent 86%);
  mix-blend-mode: soft-light;
}
.splash-rain-canvas {
  position: absolute; top: 0; right: 0; bottom: 0; left: 0;
  width: 100%; height: 100%;
}
.fx-weather-wind .splash-weather-fx {
  opacity: 0.55;
  background-image: linear-gradient(100deg, transparent 40%, rgba(255,220,160,.22) 50%, transparent 60%);
  background-size: 200% 100%;
  animation: splash-wind 2.2s linear infinite;
}
.fx-weather-fog .splash-weather-fx {
  opacity: 0.4;
  background: radial-gradient(ellipse 80% 40% at 50% 70%, rgba(255,255,255,.3), transparent 70%);
  animation: splash-fog-flow 5s ease-in-out infinite alternate;
}
@keyframes splash-rain-mist {
  from { transform: translateX(-2%); opacity: 0.75; }
  to { transform: translateX(3%); opacity: 1; }
}
.splash-caption {
  position: absolute;
  left: 0; right: 0; bottom: 12%;
  z-index: 10;
  text-align: center;
  font-size: 28rpx;
  letter-spacing: 0.2em;
  color: rgba(255, 250, 240, 0.92);
  text-shadow: 0 2rpx 12rpx rgba(40, 30, 20, 0.45);
  animation: splash-caption-in 1.2s ease 0.4s both;
  transition: color 1.25s ease;
}
.light-morning .splash-caption,
.light-midday .splash-caption,
.light-afternoon .splash-caption {
  color: rgba(90, 70, 50, 0.88);
  text-shadow: 0 2rpx 10rpx rgba(255, 255, 255, 0.5);
}
.light-evening .splash-caption,
.light-late .splash-caption {
  color: rgba(255, 245, 230, 0.9);
  text-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.55);
}
@keyframes splash-caption-in {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: none; }
}
@keyframes splash-fog-flow {
  from { opacity: 0.4; transform: translateX(-3%); }
  to { opacity: 0.75; transform: translateX(4%); }
}
@keyframes splash-heatwave {
  0%, 100% { transform: scaleY(1) translateY(0); opacity: 0.4; filter: blur(0); }
  50% { transform: scaleY(1.02) translateY(-1%); opacity: 0.7; filter: blur(1px); }
}
@keyframes splash-leaves {
  from { background-position: 10% -5%, 40% -8%, 70% -3%; opacity: 0.3; }
  to { background-position: -10% 110%, 20% 115%, 50% 120%; opacity: 0.85; }
}
@keyframes splash-fireface {
  0%, 100% { opacity: 0.45; transform: scale(1); }
  40% { opacity: 0.85; transform: scale(1.04); }
  70% { opacity: 0.55; transform: scale(0.98); }
}
@keyframes splash-embers {
  from { background-position: 0 0, 0 0, 0 0; opacity: 0.5; }
  to { background-position: -8% -40%, 6% -55%, -4% -35%; opacity: 0.9; }
}
@keyframes splash-wind {
  from { background-position: 120% 0; }
  to { background-position: -40% 0; }
}
.low .star, .low .glint, .low .mist, .low .bit, .low .spark, .low .ear, .low .pose-nap, .low .glow { animation: none; }
.has-fire.low .flame { animation: flicker 1.1s ease-in-out infinite; }
.no-fire.low .mist { animation: drift 16s linear infinite; }
.fire-boost .glow { opacity: 1; transform: scale(1.35); }
@keyframes twinkle { 50% { opacity: .25; } }
@keyframes glint { from { transform: translateX(-40%); } to { transform: translateX(80%); } }
@keyframes drift { to { transform: translateX(12%); } }
@keyframes flicker { 50% { transform: scaleX(.86) scaleY(1.08); } }
@keyframes glow { 50% { opacity: .55; } }
@keyframes rise { to { transform: translateY(-80rpx); opacity: 0; } }
@keyframes fall { to { transform: translateY(110vh); } }
@keyframes ear { 50% { transform: rotate(8deg); } }
@keyframes nod { 40% { transform: rotate(6deg); } 100% { transform: none; } }
@keyframes yes { 30% { transform: translateY(6rpx); } 60% { transform: translateY(0); } 80% { transform: translateY(4rpx); } }
@keyframes hug { 40% { transform: scale(1.06) translateY(-8rpx); } 100% { transform: none; } }
@keyframes doze { 50% { transform: rotate(4deg) translateY(4rpx); } }
@keyframes wake { 40% { transform: translateY(-8rpx) rotate(-3deg); } }
@keyframes tap { 50% { transform: rotate(12deg); } }
@keyframes write { 50% { transform: rotate(-8deg) translateY(4rpx); } }
@keyframes type-dot { 50% { opacity: .9; } }
@keyframes wave { 50% { transform: scaleY(1.6); } }
@keyframes fadeup { to { opacity: 0; transform: translateY(-36rpx); } }
@keyframes mote { to { opacity: 0; transform: translateY(-80rpx); } }
@keyframes splash-in { from { opacity: 0; transform: translateY(30px) scale(.95); } to { opacity: 1; transform: none; } }
