page { height: 100%; background: #243044; }
.valley {
  position: relative;
  height: 100%;
  overflow: hidden;
  color: #5c5348;
  font-family: "Yuanti SC", "STYuanti", "PingFang SC", sans-serif;
}
.sky, .land, .hill, .tint, .tree, .tent, .shelter, .stream, .mist { position: absolute; pointer-events: none; }
.sky { inset: 0; }
.sky-dawn .sky { background: linear-gradient(#d5e2ea, #f4e3d4 70%); }
.sky-morning .sky { background: linear-gradient(#cfe4f4, #f7efd8); }
.sky-noon .sky { background: linear-gradient(#9ecdf0, #f6e7b4); }
.sky-afternoon .sky { background: linear-gradient(#f0c48a, #f6e2b8 60%); }
.sky-dusk .sky { background: linear-gradient(#5c3d78, #e39258 55%, #f2c48a); }
.sky-night .sky { background: linear-gradient(#12182a, #24324e 70%); }
.sky-late .sky { background: linear-gradient(#070b14, #1a2033); }
.sun {
  position: absolute;
  left: 18%;
  top: 16%;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffe7a8;
  box-shadow: 0 0 40rpx #ffe7a8;
  transform-origin: 180rpx 220rpx;
}
.light-fire .sun, .sky-night .sun, .sky-late .sun { opacity: 0; }
.star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #fff8e8;
  animation: twinkle 3.2s ease-in-out infinite;
}
.hill { left: -10%; right: -10%; border-radius: 50% 50% 0 0; }
.hill.far { bottom: 38%; height: 180rpx; background: rgba(120, 146, 120, 0.35); }
.hill.near { bottom: 32%; height: 140rpx; background: rgba(92, 122, 86, 0.45); }
.sky-night .hill.far, .sky-late .hill.far { background: #1c2638; }
.sky-night .hill.near, .sky-late .hill.near { background: #243044; }
.land { left: 0; right: 0; bottom: 0; height: 42%; }
.ground-grass .land, .ground-shade .land, .ground-gold .land, .ground-bank .land { background: linear-gradient(#8eae72, #6d8b56); }
.ground-shade .land { background: linear-gradient(#7f9a68, #5d754c); }
.ground-gold .land { background: linear-gradient(#c4a15e, #8d9a5c); }
.ground-camp .land { background: linear-gradient(#6d5a42, #3d3428); }
.ground-snow .land { background: linear-gradient(#f4f7fb, #d5dde6); }
.tree {
  left: 8%;
  bottom: 34%;
  width: 180rpx;
  height: 240rpx;
  background: radial-gradient(circle at 50% 30%, #6e8f55, #3f5a34 70%);
  border-radius: 80rpx 80rpx 20rpx 20rpx;
}
.stream {
  left: 0; right: 0; bottom: 36%; height: 70rpx;
  background: linear-gradient(#b7d4d4, #8fb8bc);
  overflow: hidden;
}
.glint {
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.55), transparent);
  animation: glint 3.6s linear infinite;
}
.mist {
  left: -20%; right: -20%; bottom: 40%; height: 120rpx;
  background: rgba(255,255,255,.35);
  filter: blur(8px);
  animation: drift 14s ease-in-out infinite alternate;
}
.tent {
  right: 8%;
  bottom: 34%;
  width: 0; height: 0;
  border-left: 70rpx solid transparent;
  border-right: 70rpx solid transparent;
  border-bottom: 120rpx solid #c46a45;
}
.sky-night .tent, .sky-late .tent { border-bottom-color: #e7b089; filter: brightness(1.15); }
.shelter-tree { left: 0; top: 0; right: 40%; bottom: 30%; background: linear-gradient(180deg, rgba(40,60,40,.28), transparent); }
.shelter-canopy {
  left: 10%; right: 10%; top: 12%; height: 180rpx;
  background: linear-gradient(#d7c4a4, rgba(215,196,164,.2));
  border-radius: 0 0 40rpx 40rpx;
}
.shelter-shed {
  left: 0; right: 0; top: 0; height: 200rpx;
  background: linear-gradient(#3a2a22, transparent);
}
.tint { inset: 0; }
.tint-rain { background: #6e88a0; }
.tint-snow { background: #e7eef5; }
.tint-cloud { background: #9aa3ad; }
.tint-none { opacity: 0; }
.campfire { position: absolute; left: 12%; bottom: 30%; width: 80rpx; height: 100rpx; }
.fire-brazier { transform: scale(.72); }
.fire-small { transform: scale(.85); }
.fire-full { transform: scale(1); }
.fire-blaze { transform: scale(1.25); }
.glow {
  position: absolute; inset: -40rpx;
  background: radial-gradient(circle, rgba(255,170,70,.55), transparent 70%);
  animation: glow 1.4s ease-in-out infinite;
}
.flame {
  position: absolute; bottom: 10rpx; left: 20rpx;
  width: 36rpx; height: 64rpx; border-radius: 40rpx 40rpx 12rpx 12rpx;
  background: linear-gradient(#ffe7a0, #f08a3c 60%, #c44820);
  animation: flicker 0.8s ease-in-out infinite;
}
.flame.b { left: 34rpx; height: 48rpx; animation-delay: -.3s; }
.spark {
  position: absolute; bottom: 70rpx; width: 6rpx; height: 6rpx; border-radius: 50%;
  background: #ffd27a;
  animation: rise 2.4s linear infinite;
}
.falls { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.bit { position: absolute; top: -10%; }
.bit.rain {
  width: 2rpx; height: 28rpx; background: rgba(230,240,248,.8);
  animation-name: fall; animation-timing-function: linear; animation-iteration-count: infinite;
}
.bit.snow {
  width: 8rpx; height: 8rpx; border-radius: 50%; background: #fff;
  animation-name: fall; animation-timing-function: linear; animation-iteration-count: infinite;
}
.wordmark {
  position: absolute; left: 0; right: 0; text-align: center;
  font-size: 22rpx; letter-spacing: 6rpx; color: rgba(255,250,242,.8);
}
.sky-dawn .wordmark, .sky-morning .wordmark, .sky-noon .wordmark, .sky-afternoon .wordmark { color: rgba(92,83,72,.55); }
.sound-btn {
  position: absolute; right: 24rpx; z-index: 5;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(253,246,236,.72); text-align: center; line-height: 56rpx; font-size: 22rpx;
}
.otter {
  position: absolute; left: 50%; bottom: 36%; width: 200rpx; margin-left: -100rpx;
  z-index: 3; transition: transform .6s ease;
}
.pose-lean { transform: rotate(-8deg) translate(18rpx, 6rpx); }
.pose-nod { animation: nod .8s ease; }
.pose-agree { animation: yes .7s ease; }
.pose-comfort { animation: hug 2s ease; }
.pose-nap { animation: doze 3.2s ease-in-out infinite; }
.pose-wake { animation: wake .45s ease; }
.pose-warmth { transform: translateY(6rpx); }
.body { width: 168rpx; height: 168rpx; border-radius: 50%; background: #f2c4a0; display: block; margin: 0 auto; }
.ear { position: absolute; top: 10rpx; width: 28rpx; height: 28rpx; border-radius: 50%; background: #c9a07a; }
.ear.left { left: 28rpx; animation: ear 4.2s ease-in-out infinite; }
.ear.right { right: 28rpx; animation: ear 4.8s ease-in-out infinite; }
.tail {
  position: absolute; right: -10rpx; bottom: 30rpx; width: 46rpx; height: 22rpx;
  border-radius: 20rpx; background: #c9a07a; opacity: 0;
}
.pose-agree .tail { opacity: 1; animation: tap .35s ease 2; }
.think {
  position: absolute; top: -36rpx; right: 0; background: #fffdf8; border-radius: 16rpx;
  padding: 4rpx 12rpx; font-size: 24rpx;
}
.prop { position: absolute; }
.scarf { left: 50rpx; top: 110rpx; width: 90rpx; height: 22rpx; background: #f4efe6; border-radius: 12rpx; }
.cocoa { right: 10rpx; top: 120rpx; width: 22rpx; height: 28rpx; background: #8a5a3a; border-radius: 0 0 8rpx 8rpx; }
.straw { left: -20rpx; top: 130rpx; width: 54rpx; height: 16rpx; background: #e6c56e; border-radius: 20rpx; }
.wizard { left: 40rpx; top: -16rpx; width: 0; height: 0; border-left: 36rpx solid transparent; border-right: 36rpx solid transparent; border-bottom: 48rpx solid #3d3558; }
.cloak { left: 20rpx; top: 90rpx; width: 150rpx; height: 70rpx; background: rgba(61,53,88,.78); border-radius: 20rpx 20rpx 40rpx 40rpx; }
.nightcap { left: 70rpx; top: -8rpx; width: 70rpx; height: 36rpx; background: #d7c4e2; border-radius: 30rpx 30rpx 0 0; }
.knit { left: 48rpx; top: -6rpx; width: 90rpx; height: 32rpx; background: #efe6da; border-radius: 16rpx; }
.umbrella { left: 120rpx; top: -30rpx; width: 80rpx; height: 40rpx; background: #6e88a0; border-radius: 80rpx 80rpx 0 0; }
.lantern { right: -70rpx; top: 80rpx; width: 28rpx; height: 36rpx; background: #f2c56b; border-radius: 8rpx; box-shadow: 0 0 24rpx #f2c56b; }
.blanket { left: 40rpx; top: 140rpx; width: 280rpx; height: 36rpx; background: rgba(232,214,190,.92); border-radius: 18rpx; }
.notebook { left: 18rpx; top: 128rpx; width: 36rpx; height: 28rpx; background: #f7f1e4; border-radius: 3rpx; }
.notebook.open { width: 52rpx; }
.quill { left: 8rpx; top: 116rpx; width: 6rpx; height: 32rpx; background: #efe6c8; transform: rotate(-20deg); }
.pose-think .quill { animation: write .6s steps(2) infinite; }
.pose-hold .notebook { transform: translate(40rpx, -36rpx); }
.replies {
  position: absolute; left: 0; right: 0; bottom: 140rpx; height: 28vh; z-index: 4;
  padding: 0 28rpx;
}
.reply { display: flex; margin-top: 12rpx; }
.bubble {
  max-width: 86%; padding: 16rpx 22rpx; font-size: 28rpx; line-height: 1.65;
  background: rgba(255,253,248,.92); border-radius: 24rpx 24rpx 24rpx 8rpx;
}
.bubble.user {
  margin-left: auto; color: #fffdf8;
  background: linear-gradient(135deg, #f2c4a0, #e8a87c);
  border-radius: 24rpx 24rpx 8rpx 24rpx;
}
.bubble.typing { display: flex; gap: 8rpx; min-width: 72rpx; }
.dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #8a9a7b; opacity: .35; animation: type-dot 1.6s ease-in-out infinite; }
.d2 { animation-delay: .2s; }
.d3 { animation-delay: .4s; }
.ghost { position: absolute; right: 28rpx; bottom: 230rpx; z-index: 6; max-width: 80%; }
.ghost.scatter { animation: fadeup 2s ease forwards; }
.ghost.scatter .mote { opacity: 1; animation: mote 2s ease forwards; }
.mote {
  position: absolute; bottom: 0; width: 8rpx; height: 8rpx; border-radius: 50%;
  background: #f2d48a; opacity: 0;
}
.wave { display: flex; gap: 6rpx; align-items: flex-end; height: 48rpx; }
.bar { width: 6rpx; height: 16rpx; background: #e8a87c; border-radius: 6rpx; animation: wave .8s ease-in-out infinite; }
.bar:nth-child(2) { animation-delay: .1s; height: 28rpx; }
.bar:nth-child(3) { animation-delay: .2s; height: 40rpx; }
.bar:nth-child(4) { animation-delay: .15s; }
.composer {
  position: absolute; left: 20rpx; right: 20rpx; bottom: 24rpx;
  z-index: 5; display: flex; gap: 12rpx; align-items: center;
}
.input {
  flex: 1; background: rgba(253,246,236,.94); border-radius: 999rpx;
  padding: 16rpx 28rpx; font-size: 28rpx;
}
.mic, .send, .rec-stop, .rec-cancel {
  width: 72rpx; height: 72rpx; border-radius: 50%; text-align: center; line-height: 72rpx;
  background: #f2c4a0; color: #fffdf8;
}
.send.off { opacity: .45; }
.rec { flex: 1; display: flex; align-items: center; gap: 16rpx; color: #fffdf8; }
.rec-time { font-size: 28rpx; }
.rec-cancel, .rec-stop { width: auto; padding: 0 24rpx; }
.settings {
  position: absolute; inset: 0; z-index: 8; background: rgba(20,16,12,.35);
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: #fdf6ec; border-radius: 28rpx 28rpx 0 0; padding: 28rpx 32rpx 48rpx;
}
.sheet-title { font-size: 30rpx; margin-bottom: 16rpx; }
.row-set { display: flex; justify-content: space-between; align-items: center; }
.sheet-note { margin-top: 12rpx; color: #b7a99a; font-size: 22rpx; }
/* —— 开屏光照系统：禁纯黑纯白，保暗部层次 + 角色本体 —— */
.splash {
  position: absolute; inset: 0; z-index: 20; overflow: hidden;
  background: var(--stage-bg, linear-gradient(180deg, #232048, #141430));
  --art-filter: none;
  --stage-bg: linear-gradient(180deg, #232048, #141430);
  --key-grad: none; --key-blend: soft-light; --key-opacity: 0;
  --rim-grad: none; --rim-opacity: 0;
  --shadow-grad: none; --shadow-opacity: 0;
  --fill-grad: none; --fill-blend: multiply; --fill-opacity: 0;
  --shade-grad: none; --shade-opacity: 0;
  --lift-grad: none; --lift-opacity: 0;
  --body-protect: none; --body-opacity: 0; --body-blend: soft-light;
  --hi-compress: none; --hi-opacity: 0;
  --bloom-opacity: 0; --scatter: 0;
}
.splash.leave { opacity: 0; transition: opacity .45s ease; }
.splash-art {
  width: 100%; height: 100%;
  filter: var(--art-filter);
  transition: filter 1.25s ease;
  opacity: 0; transform: translateY(30px) scale(.95);
}
.splash.on .splash-art {
  animation: splash-in 1.8s cubic-bezier(.22,1,.36,1) forwards;
}
.splash-fill, .splash-hi, .splash-shade, .splash-key, .splash-rim, .splash-shadow,
.splash-lift, .splash-body, .splash-veil, .splash-bloom,
.splash-period-fx, .splash-weather-fx {
  position: absolute; inset: 0; pointer-events: none;
  transition: opacity 1.25s ease, background 1.25s ease, filter 1.25s ease;
}
.splash-fill {
  z-index: 1;
  background: var(--fill-grad);
  opacity: var(--fill-opacity);
  mix-blend-mode: var(--fill-blend);
}
.splash-hi {
  z-index: 2;
  background: var(--hi-compress);
  opacity: var(--hi-opacity);
  mix-blend-mode: multiply;
}
.splash-shade {
  z-index: 2;
  background: var(--shade-grad);
  opacity: var(--shade-opacity);
  mix-blend-mode: multiply;
}
.splash-key {
  z-index: 3;
  background: var(--key-grad);
  opacity: var(--key-opacity);
  mix-blend-mode: var(--key-blend);
}
.splash-rim {
  z-index: 4;
  background: var(--rim-grad);
  opacity: var(--rim-opacity);
  mix-blend-mode: screen;
}
.splash-shadow {
  z-index: 4;
  background: var(--shadow-grad);
  opacity: var(--shadow-opacity);
  mix-blend-mode: multiply;
}
.splash-lift {
  z-index: 5;
  background: var(--lift-grad);
  opacity: var(--lift-opacity);
  mix-blend-mode: soft-light;
}
.splash-body {
  z-index: 5;
  background: var(--body-protect);
  opacity: var(--body-opacity);
  mix-blend-mode: var(--body-blend);
}
.light-late .splash-rim,
.light-late .splash-bloom {
  opacity: 0 !important;
  background: none !important;
  filter: none !important;
}
.splash-veil { z-index: 6; opacity: 0; }
.veil-soft .splash-veil {
  opacity: 0.45;
  background: radial-gradient(ellipse 90% 70% at 50% 40%, rgba(200,205,215,0.35), rgba(160,165,180,0.2) 60%, transparent 85%);
  mix-blend-mode: soft-light;
  filter: blur(2px);
}
.veil-cold .splash-veil {
  opacity: calc(0.35 + var(--scatter) * 0.4);
  background:
    linear-gradient(180deg, rgba(140,160,180,0.35) 0%, rgba(100,120,140,0.22) 50%, rgba(80,100,120,0.3) 100%);
  mix-blend-mode: color;
}
.veil-mist .splash-veil {
  opacity: 0.55;
  background:
    radial-gradient(ellipse 100% 60% at 50% 60%, rgba(220,230,245,0.4), transparent 70%),
    linear-gradient(180deg, rgba(180,190,210,0.25), rgba(100,110,130,0.2));
  mix-blend-mode: soft-light;
  filter: blur(6px);
  animation: splash-fog-flow 6s ease-in-out infinite alternate;
}
.splash-bloom {
  z-index: 7;
  opacity: var(--bloom-opacity);
  background:
    radial-gradient(ellipse 55% 48% at 50% 58%, rgba(200,215,245,0.35) 0%, rgba(160,180,230,0.14) 40%, transparent 70%);
  mix-blend-mode: soft-light;
  filter: blur(10px);
}
.splash-period-fx { z-index: 8; opacity: 0; }
.fx-period-mist .splash-period-fx {
  opacity: 0.55;
  background:
    radial-gradient(ellipse 70% 30% at 30% 70%, rgba(255,255,255,0.28), transparent 70%),
    radial-gradient(ellipse 60% 25% at 70% 55%, rgba(255,250,240,0.2), transparent 70%);
  filter: blur(8px);
  animation: splash-fog-flow 7s ease-in-out infinite alternate;
}
.fx-period-heat .splash-period-fx {
  opacity: 0.5;
  background:
    repeating-linear-gradient(0deg, transparent 0 10px, rgba(255,200,120,0.04) 10px 12px);
  mix-blend-mode: soft-light;
  animation: splash-heatwave 2.8s ease-in-out infinite;
}
.fx-period-leaves .splash-period-fx {
  opacity: 0.7;
  background-image:
    radial-gradient(ellipse 6px 4px at 20% 10%, rgba(160,90,40,0.7), transparent 70%),
    radial-gradient(ellipse 5px 3px at 60% 0%, rgba(180,100,50,0.65), transparent 70%),
    radial-gradient(ellipse 7px 4px at 80% 20%, rgba(140,80,30,0.6), transparent 70%);
  background-size: 100% 100%;
  animation: splash-leaves 5.5s linear infinite;
}
.fx-period-fireface .splash-period-fx {
  opacity: 0.45;
  background: radial-gradient(ellipse 40% 35% at 66% 68%, rgba(255,140,60,0.28), transparent 70%);
  mix-blend-mode: soft-light;
  animation: splash-fireface 1.1s ease-in-out infinite;
}
.fx-period-embers .splash-period-fx {
  opacity: 0.75;
  background-image:
    radial-gradient(circle 2px at 55% 80%, rgba(255,160,80,0.9), transparent 70%),
    radial-gradient(circle 1.5px at 62% 85%, rgba(255,120,40,0.8), transparent 70%),
    radial-gradient(circle 1.5px at 48% 88%, rgba(255,180,100,0.75), transparent 70%);
  animation: splash-embers 4.5s linear infinite;
}
.splash-weather-fx { z-index: 9; opacity: 0; }
.fx-weather-rain .splash-weather-fx {
  opacity: 1;
  background: none;
  animation: none;
}
.splash-rain {
  position: absolute; inset: 0; pointer-events: none;
  opacity: 0.34;
}
.splash-rain.late { opacity: 0.22; }
.splash-rain-mist {
  position: absolute; left: 0; right: 0; bottom: 0; height: 28%;
  background: linear-gradient(180deg, transparent 0%, rgba(210,215,220,0.1) 55%, rgba(190,196,205,0.14) 100%);
  filter: blur(6px);
  animation: splash-rain-mist 7s ease-in-out infinite alternate;
}
.splash-rain-ground {
  position: absolute; left: 0; right: 0; bottom: 0; height: 22%;
  background:
    linear-gradient(180deg, transparent 0%, rgba(30,36,48,0.22) 45%, rgba(24,28,38,0.32) 100%),
    linear-gradient(90deg, transparent 10%, rgba(255,255,255,0.08) 48%, transparent 86%);
  mix-blend-mode: soft-light;
}
.splash-rain-layer { position: absolute; inset: 0; }
.splash-rain-drop {
  position: absolute;
  border-radius: 999px;
  background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.5) 45%, rgba(255,255,255,0) 100%);
  transform-origin: top center;
  animation-name: splash-rain-fall;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  will-change: transform;
}
.splash-rain-drop.hero {
  opacity: 0.55 !important;
  width: 2.4px !important;
  filter: brightness(1.35);
}
.fx-weather-wind .splash-weather-fx {
  opacity: 0.55;
  background-image: linear-gradient(100deg, transparent 40%, rgba(255,220,160,.22) 50%, transparent 60%);
  background-size: 200% 100%;
  animation: splash-wind 2.2s linear infinite;
}
.fx-weather-fog .splash-weather-fx {
  opacity: 0.4;
  background: radial-gradient(ellipse 80% 40% at 50% 70%, rgba(255,255,255,.3), transparent 70%);
  animation: splash-fog-flow 5s ease-in-out infinite alternate;
}
@keyframes splash-rain-fall {
  0% { transform: translate3d(0, -10%, 0) rotate(var(--angle, 10deg)); }
  50% { transform: translate3d(var(--sway, 2px), 55%, 0) rotate(var(--angle, 10deg)); }
  100% { transform: translate3d(calc(var(--sway, 2px) * -0.6), 120%, 0) rotate(var(--angle, 10deg)); }
}
@keyframes splash-rain-mist {
  from { transform: translateX(-2%); opacity: 0.75; }
  to { transform: translateX(3%); opacity: 1; }
}
.splash-caption {
  position: absolute;
  left: 0; right: 0; bottom: 12%;
  z-index: 10;
  text-align: center;
  font-size: 28rpx;
  letter-spacing: 0.2em;
  color: rgba(255, 250, 240, 0.92);
  text-shadow: 0 2rpx 12rpx rgba(40, 30, 20, 0.45);
  animation: splash-caption-in 1.2s ease 0.4s both;
  transition: color 1.25s ease;
}
.light-morning .splash-caption,
.light-midday .splash-caption,
.light-afternoon .splash-caption {
  color: rgba(90, 70, 50, 0.88);
  text-shadow: 0 2rpx 10rpx rgba(255, 255, 255, 0.5);
}
.light-evening .splash-caption,
.light-late .splash-caption {
  color: rgba(255, 245, 230, 0.9);
  text-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.55);
}
@keyframes splash-caption-in {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: none; }
}
@keyframes splash-fog-flow {
  from { opacity: 0.4; transform: translateX(-3%); }
  to { opacity: 0.75; transform: translateX(4%); }
}
@keyframes splash-heatwave {
  0%, 100% { transform: scaleY(1) translateY(0); opacity: 0.4; filter: blur(0); }
  50% { transform: scaleY(1.02) translateY(-1%); opacity: 0.7; filter: blur(1px); }
}
@keyframes splash-leaves {
  from { background-position: 10% -5%, 40% -8%, 70% -3%; opacity: 0.3; }
  to { background-position: -10% 110%, 20% 115%, 50% 120%; opacity: 0.85; }
}
@keyframes splash-fireface {
  0%, 100% { opacity: 0.45; transform: scale(1); }
  40% { opacity: 0.85; transform: scale(1.04); }
  70% { opacity: 0.55; transform: scale(0.98); }
}
@keyframes splash-embers {
  from { background-position: 0 0, 0 0, 0 0; opacity: 0.5; }
