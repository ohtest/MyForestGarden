/* —— 舞台：深蓝紫深空 + 暖金微光 —— */
.stage {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #e8e0f5;
  background: #0a0818;
}

.stage__bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 90% 60% at 50% 42%, rgba(72, 48, 120, 0.55), transparent 68%),
    radial-gradient(ellipse 50% 35% at 20% 75%, rgba(40, 55, 120, 0.35), transparent 70%),
    radial-gradient(ellipse 45% 30% at 82% 20%, rgba(90, 60, 140, 0.28), transparent 65%),
    linear-gradient(180deg, #14102a 0%, #0c0a1c 48%, #070612 100%);
}

/* 书后方暖金柔光，把主体托在画面中心 */
.stage__glow {
  position: absolute;
  left: 50%;
  top: 42%;
  width: 70vw;
  height: 70vw;
  max-width: 560rpx;
  max-height: 560rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 168, 90, 0.16) 0%, rgba(120, 80, 180, 0.08) 42%, transparent 70%);
  pointer-events: none;
  animation: glow-pulse 5.5s ease-in-out infinite;
}

@keyframes glow-pulse {
  0%, 100% { opacity: 0.75; transform: translate(-50%, -50%) scale(0.96); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.04); }
}

/* 薄雾 */
.stage__fog {
  position: absolute;
  border-radius: 50%;
  filter: blur(48rpx);
  pointer-events: none;
  animation: fog-drift 16s ease-in-out infinite alternate;
}

.stage__fog--a {
  width: 520rpx;
  height: 320rpx;
  left: -80rpx;
  top: 22%;
  background: rgba(130, 100, 190, 0.2);
}

.stage__fog--b {
  width: 460rpx;
  height: 300rpx;
  right: -60rpx;
  bottom: 18%;
  background: rgba(70, 100, 170, 0.18);
  animation-duration: 20s;
  animation-delay: -5s;
}

.stage__fog--c {
  width: 380rpx;
  height: 220rpx;
  left: 30%;
  top: 58%;
  background: rgba(200, 160, 100, 0.08);
  animation-duration: 18s;
  animation-delay: -2s;
}

@keyframes fog-drift {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(40rpx, -28rpx, 0); }
}

/* 金色微光粒子 */
.particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}

.particle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, #f5e6b8 0%, rgba(245, 230, 184, 0) 70%);
  box-shadow: 0 0 8rpx rgba(245, 210, 140, 0.55);
  animation: particle-float ease-in-out infinite;
}

@keyframes particle-float {
  0%, 100% { transform: translate3d(0, 0, 0) scale(1); opacity: 0.2; }
  50% { transform: translate3d(10rpx, -36rpx, 0) scale(1.2); opacity: 0.9; }
}

/* 竖版构图：整屏舞台，底栏避让 */
.stage__inner {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  padding: 0 0 calc(100rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 锚点：画面几何中心（略上移避开底栏）；保持 3:4 */
.book-anchor {
  position: absolute;
  left: 50%;
  top: 43%;
  transform: translate(-50%, -50%);
  width: min(78vw, 49.5vh, 580rpx);
  height: min(104vw, 66vh, 773rpx);
  z-index: 3;
}

.book-anchor--flipping {
  width: min(84vw, 51vh, 620rpx);
  height: min(112vw, 68vh, 827rpx);
}

/* —— 书籍：填满锚点 —— */
.book-wrap {
  position: relative;
  width: 100%;
  height: 100%;
}

.book-wrap--awake {
  animation: book-awaken 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes book-awaken {
  0% { transform: scale(1); }
  45% { transform: scale(1.06); }
  100% { transform: scale(1.03); }
}

.book {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
}

/* 悬浮 + 呼吸缩放 0.98–1.02，无缝循环 */
.book--breathe {
  animation: book-breathe 4.8s ease-in-out infinite;
}

@keyframes book-breathe {
  0%, 100% { transform: translateY(0) scale(0.98); }
  50% { transform: translateY(-18rpx) scale(1.02); }
}

.book--pulse {
  animation: book-pulse 0.5s cubic-bezier(0.34, 1.2, 0.64, 1);
}

@keyframes book-pulse {
  0% { filter: brightness(1); }
  45% {
    filter: brightness(1.28);
    box-shadow: 0 0 80rpx rgba(245, 210, 140, 0.55), 0 0 140rpx rgba(140, 100, 210, 0.35);
  }
  100% {
    filter: brightness(1.12);
    box-shadow: 0 0 48rpx rgba(245, 210, 140, 0.4);
  }
}

.book__shadow {
  position: absolute;
  left: 10%;
  right: 6%;
  bottom: -28rpx;
  height: 48rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(0, 0, 0, 0.45) 0%, transparent 70%);
  filter: blur(8rpx);
  animation: shadow-breathe 4.8s ease-in-out infinite;
  pointer-events: none;
}

@keyframes shadow-breathe {
  0%, 100% { opacity: 0.7; transform: scaleX(1); }
  50% { opacity: 0.45; transform: scaleX(0.9); }
}

.book__spine {
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 28rpx;
  border-radius: 10rpx 0 0 10rpx;
  background: linear-gradient(90deg, #1a1230 0%, #3a2a5c 45%, #2a1e48 100%);
  box-shadow: inset -2rpx 0 6rpx rgba(0, 0, 0, 0.35);
  z-index: 2;
}

.book__edge {
  position: absolute;
  right: -12rpx;
  top: 14rpx;
  bottom: 14rpx;
  width: 16rpx;
  border-radius: 0 10rpx 10rpx 0;
  background: linear-gradient(180deg, #e2c48a 0%, #a8894a 35%, #d4bc8a 65%, #7a6238 100%);
  opacity: 0.9;
  z-index: 1;
}

.book__cover {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 12rpx 20rpx 20rpx 12rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-left: 16rpx;
  box-sizing: border-box;
  background:
    linear-gradient(145deg, rgba(245, 220, 160, 0.18) 0%, transparent 38%),
    linear-gradient(180deg, #3b2a62 0%, #2a1d4a 42%, #1a1232 100%);
  border: 2rpx solid rgba(226, 196, 138, 0.65);
  box-shadow:
    0 32rpx 72rpx rgba(0, 0, 0, 0.5),
    0 0 40rpx rgba(180, 140, 80, 0.12),
    inset 0 0 50rpx rgba(0, 0, 0, 0.35),
    inset 0 0 0 14rpx rgba(212, 188, 138, 0.1);
}

.book__frame {
  position: absolute;
  inset: 28rpx 24rpx 28rpx 36rpx;
  border: 1rpx solid rgba(226, 196, 138, 0.35);
  border-radius: 8rpx;
  pointer-events: none;
}

/* 烫金扫光 */
.book__foil {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    115deg,
    transparent 32%,
    rgba(245, 220, 160, 0.22) 48%,
    transparent 64%
  );
  background-size: 240% 100%;
  animation: foil-sweep 6s ease-in-out infinite;
  pointer-events: none;
}

@keyframes foil-sweep {
  0%, 100% { background-position: 130% 0; }
  50% { background-position: -30% 0; }
}

.book__title {
  position: relative;
  z-index: 1;
  font-size: 48rpx;
  letter-spacing: 0.42em;
  color: #f3d9a0;
  text-shadow: 0 0 24rpx rgba(243, 217, 160, 0.45);
  margin: 16rpx 0 14rpx 20rpx;
  font-weight: 500;
}

.book__sigil {
  position: relative;
  z-index: 1;
  font-size: 30rpx;
  color: rgba(243, 217, 160, 0.8);
  letter-spacing: 0.22em;
  margin-left: 12rpx;
}

.book__ornament {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  color: rgba(243, 217, 160, 0.55);
}

.book__ornament--top { margin-bottom: 12rpx; }
.book__ornament--bottom { margin-top: 36rpx; }

/* 引导文案：书下方固定区域 */
.guide {
  position: absolute;
  left: 0;
  right: 0;
  top: 78%;
  text-align: center;
  z-index: 3;
}

.guide__text {
  display: block;
  font-size: 28rpx;
  color: rgba(230, 218, 245, 0.78);
  letter-spacing: 0.14em;
  animation: guide-breathe 2.8s ease-in-out infinite;
}

@keyframes guide-breathe {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 0.95; }
}

/* —— 翻页：3D 透视 + 纸张厚度 + 阴影变化 —— */
.flip {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.flip__scene {
  position: relative;
  width: 100%;
  height: 86%;
  perspective: 1600px;
  perspective-origin: 50% 45%;
  transform-style: preserve-3d;
}

/* 下层书页：叠出厚度 */
.flip__bed {
  position: absolute;
  inset: 0;
  transform-style: preserve-3d;
}

.flip__bed-page {
  position: absolute;
  inset: 0;
  border-radius: 8rpx 16rpx 16rpx 8rpx;
  background:
    linear-gradient(105deg, rgba(255, 255, 255, 0.25) 0%, transparent 30%),
    linear-gradient(180deg, #f3ebe0 0%, #e5d9c6 100%);
  border: 1rpx solid rgba(170, 150, 110, 0.35);
  box-shadow:
    0 18rpx 40rpx rgba(0, 0, 0, 0.35),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.2);
}

.flip__bed-page--2 {
  transform: translate3d(3rpx, 4rpx, -4px);
  opacity: 0.92;
  filter: brightness(0.97);
}

.flip__bed-page--3 {
  transform: translate3d(6rpx, 8rpx, -8px);
  opacity: 0.85;
  filter: brightness(0.94);
  background: linear-gradient(180deg, #3b2a62 0%, #1a1232 100%);
  border-color: rgba(226, 196, 138, 0.35);
}

.flip__spine-shade {
  position: absolute;
  left: 0;
  top: 2%;
  bottom: 2%;
  width: 18rpx;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.28), transparent);
  border-radius: 8rpx 0 0 8rpx;
  pointer-events: none;
  z-index: 5;
}

.flip__stack {
  position: absolute;
  inset: 0;
  transform-style: preserve-3d;
}

.flip__leaf {
  position: absolute;
  inset: 0;
  transform-origin: left center;
  transform-style: preserve-3d;
  --flip-ms: 400ms;
  --end-y: -178deg;
  --mid-y: -92deg;
  --curl: 0deg;
  --lift: 18px;
  --ease: cubic-bezier(0.22, 0.72, 0.28, 1);
}

.flip__leaf--ease-a { --ease: cubic-bezier(0.22, 0.72, 0.28, 1); }
.flip__leaf--ease-b { --ease: cubic-bezier(0.18, 0.85, 0.32, 1); }
.flip__leaf--ease-c { --ease: cubic-bezier(0.25, 0.6, 0.2, 1); }
.flip__leaf--ease-d { --ease: cubic-bezier(0.15, 0.78, 0.35, 0.98); }

.flip__leaf--wait {
  opacity: 0;
  visibility: hidden;
  transform: rotateY(0deg);
}

.flip__leaf--turn {
  opacity: 1;
  visibility: visible;
  /* 真实纸张翻动：角度/抬升/卷曲由 CSS 变量注入，每页略有差异 */
  animation-name: paper-flip;
  animation-duration: var(--flip-ms);
  animation-timing-function: var(--ease);
  animation-fill-mode: forwards;
}

.flip__leaf--gone {
  opacity: 0;
  visibility: hidden;
  transform: rotateY(var(--end-y)) rotateZ(calc(var(--curl) * -0.3));
  pointer-events: none;
}

/* 纸张翻动主曲线：过垂直面时抬升最强，阴影最重 */
@keyframes paper-flip {
  0% {
    transform: rotateY(0deg) rotateZ(0deg) translateZ(0);
  }
  18% {
    transform: rotateY(-32deg) rotateZ(calc(var(--curl) * 0.6)) translateZ(calc(var(--lift) * 0.35));
  }
  48% {
    transform: rotateY(var(--mid-y)) rotateZ(var(--curl)) translateZ(var(--lift));
  }
  78% {
    transform: rotateY(-145deg) rotateZ(calc(var(--curl) * 0.4)) translateZ(calc(var(--lift) * 0.45));
  }
  100% {
    transform: rotateY(var(--end-y)) rotateZ(calc(var(--curl) * -0.25)) translateZ(2px);
  }
}

.flip__sheet {
  position: absolute;
  inset: 0;
  transform-style: preserve-3d;
  border-radius: 8rpx 16rpx 16rpx 8rpx;
}

/* 投射阴影：翻到侧面时变窄变深 */
.flip__cast {
  position: absolute;
  left: 4%;
  right: -6%;
  top: 6%;
  bottom: 4%;
  border-radius: 8rpx;
  background: radial-gradient(ellipse at left center, rgba(0, 0, 0, 0.45) 0%, transparent 70%);
  transform-origin: left center;
  pointer-events: none;
  opacity: 0.25;
  filter: blur(10rpx);
  z-index: -1;
}

.flip__leaf--turn .flip__cast {
  animation-name: cast-shadow;
  animation-duration: var(--flip-ms);
  animation-timing-function: var(--ease);
  animation-fill-mode: forwards;
}

@keyframes cast-shadow {
  0% {
    opacity: 0.2;
    transform: rotateY(0deg) scaleX(1) translateX(0);
    filter: blur(8rpx);
  }
  45% {
    opacity: 0.7;
    transform: rotateY(-20deg) scaleX(0.55) translateX(8%);
    filter: blur(16rpx);
  }
  100% {
    opacity: 0.05;
    transform: rotateY(-80deg) scaleX(0.2) translateX(-10%);
    filter: blur(6rpx);
  }
}

.flip__face {
  position: absolute;
  inset: 0;
  border-radius: 8rpx 16rpx 16rpx 8rpx;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.flip__face--front {
  background:
    linear-gradient(105deg, rgba(255, 255, 255, 0.4) 0%, transparent 32%),
    linear-gradient(180deg, #f8f2e8 0%, #ebe0ce 55%, #e2d4be 100%);
  border: 1rpx solid rgba(180, 160, 120, 0.45);
  box-shadow:
    0 16rpx 40rpx rgba(0, 0, 0, 0.32),
    inset -10rpx 0 20rpx rgba(0, 0, 0, 0.06);
}

.flip__face--back {
  background:
    linear-gradient(180deg, #e6dccb 0%, #d4c6b0 100%);
  transform: rotateY(180deg);
  border: 1rpx solid rgba(150, 130, 95, 0.35);
  box-shadow: inset 12rpx 0 24rpx rgba(0, 0, 0, 0.12);
}

/* 纸张侧边厚度：翻页中段更明显 */
.flip__thickness {
  position: absolute;
  left: 0;
  top: 1%;
  bottom: 1%;
  width: 10rpx;
  transform: translateX(-50%) rotateY(90deg);
  transform-origin: center center;
  background: linear-gradient(180deg, #f0e6d4 0%, #cbb996 45%, #a89068 100%);
  box-shadow: 0 0 6rpx rgba(0, 0, 0, 0.2);
  opacity: 0.15;
  z-index: 2;
}

.flip__leaf--turn .flip__thickness {
  animation-name: thickness-flash;
  animation-duration: var(--flip-ms);
  animation-timing-function: var(--ease);
  animation-fill-mode: forwards;
}

@keyframes thickness-flash {
  0%, 100% { opacity: 0.1; }
  40%, 55% { opacity: 0.85; }
}

/* 纸面纹理 */
.flip__grain {
  position: absolute;
  inset: 0;
  opacity: 0.18;
  background-image:
    radial-gradient(rgba(90, 70, 40, 0.15) 0.6px, transparent 0.7px);
  background-size: 6px 6px;
  pointer-events: none;
}

.flip__grain--back { opacity: 0.12; }

/* 翻页高光扫过纸面 */
.flip__sheen {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    100deg,
    transparent 30%,
    rgba(255, 255, 255, 0.35) 48%,
    transparent 62%
  );
  background-size: 220% 100%;
  opacity: 0;
  pointer-events: none;
}

.flip__leaf--turn .flip__sheen {
  animation-name: page-sheen;
  animation-duration: var(--flip-ms);
  animation-timing-function: var(--ease);
  animation-fill-mode: forwards;
}

@keyframes page-sheen {
  0% { opacity: 0; background-position: 120% 0; }
  35% { opacity: 0.7; background-position: 40% 0; }
  70% { opacity: 0.25; background-position: -10% 0; }
  100% { opacity: 0; background-position: -40% 0; }
}

/* 模糊行纹：不可读检索感 */
.flip__lines {
  position: absolute;
  left: 14%;
  right: 12%;
  top: 20%;
  bottom: 20%;
  background: repeating-linear-gradient(
    180deg,
    rgba(90, 70, 110, 0.14) 0,
    rgba(90, 70, 110, 0.14) 10rpx,
    transparent 10rpx,
    transparent 28rpx
  );
  filter: blur(2px);
  opacity: 0.65;
}

.flip__blur {
  position: relative;
  z-index: 1;
  font-size: 36rpx;
  color: rgba(70, 55, 90, 0.38);
  letter-spacing: 0.45em;
  filter: blur(3.5px);
}

.flip__leaf--turn .flip__face--front {
  animation-name: face-shade;
  animation-duration: var(--flip-ms);
  animation-timing-function: var(--ease);
  animation-fill-mode: forwards;
}

/* 正面受光：过垂直后变暗，模拟背光 */
@keyframes face-shade {
  0% { filter: brightness(1.05); }
  40% { filter: brightness(1.12); }
  55% { filter: brightness(0.72); }
  100% { filter: brightness(0.55); }
}

.flip__hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: rgba(230, 218, 245, 0.55);
  letter-spacing: 0.16em;
  animation: guide-breathe 1.6s ease-in-out infinite;
}

/* —— 结果：答案与团团同框，团团在右下 —— */
.result {
  position: absolute;
  left: 50%;
  top: 46%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-width: 660rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: result-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  z-index: 4;
}

@keyframes result-in {
  from {
    opacity: 0;
    transform: translate(-50%, -46%) scale(0.92);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

/* 同一卡片：答案在左上，团团叠在右下且不被挡住 */
.result__card {
  position: relative;
  width: 100%;
  min-height: 420rpx;
  border-radius: 22rpx;
  background: linear-gradient(165deg, #f7f1e6 0%, #ebe2d2 100%);
  border: 1rpx solid rgba(212, 188, 138, 0.5);
  box-shadow:
    0 28rpx 72rpx rgba(0, 0, 0, 0.42),
    0 0 56rpx rgba(160, 120, 220, 0.2);
  overflow: visible;
  animation: sheet-reveal 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes sheet-reveal {
  from {
    opacity: 0;
    transform: translateY(20rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.result__body {
  position: relative;
  z-index: 2;
  padding: 48rpx 200rpx 56rpx 40rpx;
  box-sizing: border-box;
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.result__label {
  font-size: 22rpx;
  letter-spacing: 0.35em;
  color: rgba(100, 85, 70, 0.55);
  margin-bottom: 28rpx;
}

.result__line {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  max-width: 100%;
  padding: 8rpx 0;
}

/* 团团：贴在卡片右下角，略探出，叠在答案之上但不压字 */
.result__mascot {
  position: absolute;
  right: -12rpx;
  bottom: -28rpx;
  width: 220rpx;
  height: 280rpx;
  z-index: 3;
  pointer-events: none;
  animation: otter-enter 0.7s cubic-bezier(0.22, 1.2, 0.36, 1) 0.15s both;
}

@keyframes otter-enter {
  from {
    opacity: 0;
    transform: translate(16rpx, 24rpx) scale(0.86);
  }
  to {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }
}

.result__mascot-glow {
  position: absolute;
  left: 50%;
  top: 55%;
  width: 200rpx;
  height: 200rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(245, 210, 140, 0.4) 0%, rgba(140, 100, 200, 0.1) 50%, transparent 72%);
  pointer-events: none;
  animation: otter-glow 2.8s ease-in-out infinite;
}

@keyframes otter-glow {
  0%, 100% { opacity: 0.65; transform: translate(-50%, -50%) scale(0.95); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.08); }
}

.result__otter {
  position: relative;
  z-index: 1;
  width: 220rpx;
  height: 280rpx;
  animation: otter-float 3.6s ease-in-out 0.7s infinite;
  filter: drop-shadow(0 12rpx 20rpx rgba(40, 30, 60, 0.28));
}

@keyframes otter-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.result__char {
  font-size: 46rpx;
  line-height: 1.6;
  color: #3a2f4a;
  opacity: 0;
  transform: translateY(8rpx);
  transition: opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

.result__char--on {
  opacity: 1;
  transform: translateY(0);
}

.result__shine {
  position: absolute;
  inset: -8rpx -24rpx;
  background: linear-gradient(
    105deg,
    transparent 30%,
    rgba(245, 220, 160, 0.45) 50%,
    transparent 70%
  );
  background-size: 220% 100%;
  animation: text-shine 2.4s cubic-bezier(0.4, 0, 0.2, 1) 0.4s 2;
  pointer-events: none;
  mix-blend-mode: soft-light;
}

@keyframes text-shine {
  0% { background-position: 120% 0; }
  100% { background-position: -40% 0; }
}

.result__actions {
  width: 100%;
  /* 给右下探出的团团留空，避免按钮顶到角色 */
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn {
  width: 100% !important;
  margin: 0 !important;
  border-radius: 999rpx !important;
  font-size: 30rpx !important;
  line-height: 2.6 !important;
  border: none !important;
}

.btn::after {
  border: none !important;
}

.btn--primary {
  background: linear-gradient(135deg, #c9a86c, #e2c48a) !important;
  color: #2a2038 !important;
  font-weight: 500;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.25);
}

.btn--ghost {
  background: rgba(255, 255, 255, 0.08) !important;
  color: rgba(232, 224, 245, 0.85) !important;
  border: 1rpx solid rgba(212, 188, 138, 0.35) !important;
}
